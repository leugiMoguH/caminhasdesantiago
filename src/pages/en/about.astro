---
import MainLayout from '../../layouts/MainLayout.astro';
import AboutContent from '../../components/AboutContent.astro';
import { SOCIAL_LINKS } from '../../lib/social';
import { AUTHOR_NAME, CONTACT_EMAIL } from '../../lib/site';

const PAGE_URL = 'https://waytosantiagoguide.com/en/about/';
const LANG = 'en';

// schemaType="none": this page supplies its own graph so it can declare an
// AboutPage plus the Person behind the guide, which the shared 'webpage' node
// has no slot for. Do not also pass schemaType="webpage" — that would emit a
// duplicate WebPage entity.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${PAGE_URL}#author`,
      name: AUTHOR_NAME,
      description: 'Writes and maintains an independent guide to the Portuguese Coastal Camino through Caminha.',
      email: `mailto:${CONTACT_EMAIL}`,
      url: PAGE_URL,
      worksFor: { '@id': 'https://waytosantiagoguide.com/#organization' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://waytosantiagoguide.com/#organization',
      name: 'Way to Santiago Guide',
      url: 'https://waytosantiagoguide.com',
      logo: { '@type': 'ImageObject', url: 'https://waytosantiagoguide.com/logo.png' },
      email: `mailto:${CONTACT_EMAIL}`,
      founder: { '@id': `${PAGE_URL}#author` },
      sameAs: [SOCIAL_LINKS.instagram, SOCIAL_LINKS.facebook],
    },
    {
      '@type': 'AboutPage',
      '@id': `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: 'About This Guide',
      description: 'Who is behind the Way to Santiago Guide, how every timetable, price and albergue on it is verified and dated, how the site earns money, and how to report a correction.',
      inLanguage: 'en-GB',
      isPartOf: { '@id': 'https://waytosantiagoguide.com/#website' },
      about: { '@id': 'https://waytosantiagoguide.com/#organization' },
      author: { '@id': `${PAGE_URL}#author` },
      publisher: { '@id': 'https://waytosantiagoguide.com/#organization' },
      breadcrumb: { '@id': `${PAGE_URL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${PAGE_URL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://waytosantiagoguide.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'About', item: PAGE_URL },
      ],
    },
  ],
};
---

<MainLayout
  title="About This Guide: Who Writes It and How the Facts Are Checked"
  description="Who is behind the Way to Santiago Guide, how every timetable, price and albergue on it is verified and dated, how the site earns money, and how to report a correction."
  lang={LANG}
  schemaType="none"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  <AboutContent lang={LANG} />
</MainLayout>
