---
/**
 * HTML sitemap — now trilingual, and generated rather than hand-listed.
 *
 * The old EN-only version kept a hardcoded list of links that had drifted well
 * behind the site: none of the route stages, towns, logistics topics, tools or
 * comparison pages appeared on it. Everything that lives in a content
 * collection is now read from the collection, so this page cannot fall behind
 * again; only the handful of standalone pages are listed by hand.
 *
 * Excluded from the XML sitemap (see astro.config.mjs) — this page is for
 * readers, not crawlers.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import {
  LANGS, SITE_URL, hubPath, stagePath, townPath, logisticsPath, ferryPath,
  caminhaGuidePath, caminhaStayPath, plannerPath, guidePath,
  coastalWhereToStayPath, bestStagesToSleepPath, cheapestAlberguesPath,
  type Lang,
} from '../../lib/clusterRoutes';

export async function getStaticPaths() {
  const [stages, towns, logistics] = await Promise.all([
    getCollection('stages', (e) => e.data.sourceVerified),
    getCollection('towns', (e) => e.data.sourceVerified),
    getCollection('logistics', (e) => e.data.sourceVerified),
  ]);
  const ordered = [...stages].sort((a, b) => a.data.order - b.data.order);
  return LANGS.map((lang) => ({
    params: { lang },
    props: {
      lang,
      stages: ordered.map((s) => ({ slug: s.id, label: s.data.i18n[lang].h1 })),
      towns: [...towns]
        .sort((a, b) => a.data.name.localeCompare(b.data.name))
        .map((x) => ({ slug: x.id, label: x.data.name })),
      logistics: [...logistics]
        .map((x) => ({ slug: x.id, label: x.data.i18n[lang].h1 }))
        .sort((a, b) => a.label.localeCompare(b.label)),
    },
  }));
}

type Item = { slug: string; label: string };
const { lang, stages, towns, logistics } = Astro.props as {
  lang: Lang; stages: Item[]; towns: Item[]; logistics: Item[];
};

const SITEMAP_SLUG = 'sitemap';
const i18nUrls = {
  en: `${SITE_URL}/en/${SITEMAP_SLUG}/`,
  es: `${SITE_URL}/es/${SITEMAP_SLUG}/`,
  pt: `${SITE_URL}/pt/${SITEMAP_SLUG}/`,
};

const C = {
  en: {
    title: 'Sitemap — Every Page on This Guide',
    desc: 'Full index of the Way to Santiago Guide: the Caminha crossing, every Coastal Route stage, towns, pilgrim logistics and planning tools, in English, Spanish and Portuguese.',
    home: 'Home', here: 'Sitemap', h1: 'Sitemap',
    lead: 'Every page on this site, grouped by topic. The guide covers the Portuguese Coastal Camino from Porto to Santiago, in most depth around Caminha and the river crossing into Spain.',
    secCaminha: 'Caminha and the crossing',
    secRoute: 'Coastal Route stages',
    secTowns: 'Towns on the route',
    secLog: 'Pilgrim logistics',
    secTools: 'Tools and comparisons',
    secAbout: 'About and legal',
    caminha: ['Caminha guide — overview', 'Ferry and logistics — Caminha to A Guarda', 'Crossing status — what is running now', 'Hotels and where to stay in Caminha', 'Where to eat in Caminha', 'Pharmacies, gear shops and ATMs', 'Coastal Camino pilgrim guide'],
    tools: ['Plan your Camino — itinerary, packing and budget', 'Pilgrim essentials — what to know before you go', 'Where to stay on the Coastal Camino', 'Best stages to sleep on', 'Cheapest albergues on the Coastal Camino'],
    about: ['About this guide', 'Privacy policy'],
  },
  es: {
    title: 'Mapa del Sitio — Todas las Páginas de la Guía',
    desc: 'Índice completo de la Guía Camino de Santiago: el cruce de Caminha, todas las etapas del Camino de la Costa, pueblos, logística del peregrino y herramientas, en inglés, español y portugués.',
    home: 'Inicio', here: 'Mapa del sitio', h1: 'Mapa del sitio',
    lead: 'Todas las páginas de este sitio, agrupadas por tema. La guía cubre el Camino Portugués de la Costa de Oporto a Santiago, con más profundidad en torno a Caminha y el cruce del río hacia España.',
    secCaminha: 'Caminha y el cruce',
    secRoute: 'Etapas del Camino de la Costa',
    secTowns: 'Pueblos de la ruta',
    secLog: 'Logística del peregrino',
    secTools: 'Herramientas y comparativas',
    secAbout: 'Sobre la guía y legal',
    caminha: ['Guía de Caminha — resumen', 'Ferry y logística — Caminha a A Guarda', 'Estado del cruce — qué opera ahora', 'Hoteles y alojamiento en Caminha', 'Dónde comer en Caminha', 'Farmacias, tiendas de equipo y cajeros', 'Guía del peregrino del Camino de la Costa'],
    tools: ['Planifica tu Camino — itinerario, equipaje y presupuesto', 'Esenciales del peregrino — lo que saber antes de ir', 'Dónde dormir en el Camino de la Costa', 'Mejores etapas para dormir', 'Albergues más baratos del Camino de la Costa'],
    about: ['Sobre esta guía', 'Política de privacidad'],
  },
  pt: {
    title: 'Mapa do Site — Todas as Páginas do Guia',
    desc: 'Índice completo do Guia Caminho de Santiago: a travessia de Caminha, todas as etapas do Caminho da Costa, localidades, logística do peregrino e ferramentas, em inglês, espanhol e português.',
    home: 'Início', here: 'Mapa do site', h1: 'Mapa do site',
    lead: 'Todas as páginas deste site, agrupadas por tema. O guia cobre o Caminho Português da Costa do Porto a Santiago, com mais profundidade à volta de Caminha e da travessia do rio para Espanha.',
    secCaminha: 'Caminha e a travessia',
    secRoute: 'Etapas do Caminho da Costa',
    secTowns: 'Localidades do percurso',
    secLog: 'Logística do peregrino',
    secTools: 'Ferramentas e comparações',
    secAbout: 'Sobre o guia e legal',
    caminha: ['Guia de Caminha — resumo', 'Ferry e logística — Caminha para A Guarda', 'Estado da travessia — o que opera agora', 'Hotéis e alojamento em Caminha', 'Onde comer em Caminha', 'Farmácias, lojas de equipamento e Multibanco', 'Guia do peregrino do Caminho da Costa'],
    tools: ['Planeia o teu Caminho — itinerário, mochila e orçamento', 'Essenciais do peregrino — o que saber antes de ir', 'Onde ficar no Caminho da Costa', 'Melhores etapas para dormir', 'Albergues mais baratos do Caminho da Costa'],
    about: ['Sobre este guia', 'Política de privacidade'],
  },
}[lang];

const eat = { en: '/en/caminha/where-to-eat/', es: '/es/caminha/donde-comer/', pt: '/pt/caminha/onde-comer/' }[lang];
const services = { en: '/en/caminha/useful-services/', es: '/es/caminha/servicios-utiles/', pt: '/pt/caminha/servicos-uteis/' }[lang];
const pilgrim = { en: '/en/caminha/pilgrim-guide/', es: '/es/caminha/guia-del-peregrino/', pt: '/pt/caminha/guia-do-peregrino/' }[lang];
const about = { en: '/en/about/', es: '/es/sobre/', pt: '/pt/sobre/' }[lang];
const privacy = { en: '/en/privacy-policy/', es: '/es/politica-de-privacidad/', pt: '/pt/politica-de-privacidade/' }[lang];

const caminhaHrefs = [
  caminhaGuidePath(lang), ferryPath(lang), `/${lang}/caminha-ferry-status/`,
  caminhaStayPath(lang), eat, services, pilgrim,
];
const toolHrefs = [
  plannerPath(lang), guidePath(lang), coastalWhereToStayPath(lang),
  bestStagesToSleepPath(lang), cheapestAlberguesPath(lang),
];
const aboutHrefs = [about, privacy];

const sections = [
  { heading: C.secCaminha, links: C.caminha.map((label, i) => ({ href: caminhaHrefs[i], label })) },
  { heading: C.secRoute, links: [{ href: hubPath(lang), label: C.secRoute }, ...stages.map((s) => ({ href: stagePath(lang, s.slug), label: s.label }))] },
  { heading: C.secTowns, links: towns.map((x) => ({ href: townPath(lang, x.slug), label: x.label })) },
  { heading: C.secLog, links: logistics.map((x) => ({ href: logisticsPath(lang, x.slug), label: x.label })) },
  { heading: C.secTools, links: C.tools.map((label, i) => ({ href: toolHrefs[i], label })) },
  { heading: C.secAbout, links: C.about.map((label, i) => ({ href: aboutHrefs[i], label })) },
];

const anchorId = (s: string) =>
  'heading-' + s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<MainLayout title={C.title} description={C.desc} lang={lang} schemaType="webpage" i18nUrls={i18nUrls}>

  <div class="bg-gradient-to-b from-slate-50 to-white border-b border-slate-100/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <nav aria-label={C.here} class="mb-5">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href={`/${lang}/`} class="hover:text-forest-700 no-underline hover:underline transition-colors">{C.home}</a></li>
          <li aria-hidden="true" class="text-slate-300">›</li>
          <li aria-current="page" class="text-slate-700 font-medium">{C.here}</li>
        </ol>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-bold text-forest-900 mb-3 tracking-tight">{C.h1}</h1>
      <p class="text-slate-600 text-base leading-relaxed max-w-2xl">{C.lead}</p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    {sections.map((section) => (
      <section aria-labelledby={anchorId(section.heading)}>
        <h2
          id={anchorId(section.heading)}
          class="text-xl font-bold text-forest-900 mb-4 pb-3 border-b border-slate-200 tracking-tight"
        >
          {section.heading}
        </h2>
        <ul class="space-y-2">
          {section.links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="inline-flex items-center gap-2 text-sm text-forest-700 hover:text-forest-900 hover:underline no-underline font-medium transition-colors"
              >
                <svg class="h-3.5 w-3.5 text-earth-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
                {label}
              </a>
              <span class="ml-6 text-xs text-slate-500 font-mono">{href}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

</MainLayout>
