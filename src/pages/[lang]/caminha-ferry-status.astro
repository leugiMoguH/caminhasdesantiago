---
/**
 * Crossing status page — now trilingual.
 *
 * Was EN-only at /en/caminha-ferry-status/ while two thirds of the audience
 * reads Spanish or Portuguese, on the site's single highest-value topic. The
 * route moved to [lang]/ so the English URL is unchanged and ES and PT now
 * exist at the same slug.
 *
 * Operator rows, fares and schedules all come from src/content/crossing/ferry.yml
 * — the prose here must never restate a figure the data file does not carry.
 * The 2026-08-12 re-verification (Xacobeo €6→€9, nine fixed departures, Taxi
 * Boat Peregrinos on request rather than every 30 min) is reflected below and
 * recorded in the changelog rather than written over the older entries.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';
import { warnIfStale } from '../../lib/freshness';
import { bookingSearch } from '../../lib/booking';
import EmailSignup from '../../components/EmailSignup.astro';
import { LANGS, ferryPath, stagePath, hubPath, caminhaStayPath, SITE_URL, type Lang } from '../../lib/clusterRoutes';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };

const SLUG = 'caminha-ferry-status';
const PAGE_PATH = `/${lang}/${SLUG}/`;
const PAGE_URL = `${SITE_URL}${PAGE_PATH}`;
const i18nUrls = {
  en: `${SITE_URL}/en/${SLUG}/`,
  es: `${SITE_URL}/es/${SLUG}/`,
  pt: `${SITE_URL}/pt/${SLUG}/`,
};

const entry = await getEntry('crossing', 'caminha-a-guarda');
const f = entry!.data;
const t = f.i18n[lang];
const ol = t.operatorLabels;

const LAST_VERIFIED = f.lastVerified;
const LOCALE = { en: 'en-GB', es: 'es-ES', pt: 'pt-PT' }[lang];
const HREFLANG = { en: 'en-GB', es: 'es-ES', pt: 'pt-PT' }[lang];
// Derived from lastVerified so the visible month, title, meta and structured
// data can never drift apart.
const STATUS_MONTH = new Date(`${LAST_VERIFIED}T00:00:00Z`).toLocaleString(LOCALE, {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const MACHINE_STATUS = f.status === 'running' ? 'operational' : 'suspended';
warnIfStale('crossing/caminha-a-guarda', LAST_VERIFIED);

const operators = f.scheduledOperators.map((op) => ({
  name: op.name,
  schedule: `${ol[op.frequency] ?? op.frequency}, ${op.hours}`,
  price: `€${op.adultEUR} (€${op.bikeEUR} ${lang === 'en' ? 'with bike' : lang === 'es' ? 'con bici' : 'com bicicleta'})`,
  booking: ol[op.booking] ?? op.booking,
  phone: op.phone,
  url: op.url,
  notes: op.note ?? '—',
}));

/** Cheapest published adult fare across the operators — never hardcode it. */
const FROM_EUR = Math.min(...f.scheduledOperators.map((op) => op.adultEUR));

