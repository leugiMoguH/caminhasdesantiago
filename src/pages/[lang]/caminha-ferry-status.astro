const relHrefs = [ferryPath(lang), stagePath(lang, 'caminha-a-guarda'), hubPath(lang), caminhaStayPath(lang)];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: C.schemaName,
      description: C.schemaDesc,
      inLanguage: HREFLANG,
      dateModified: LAST_VERIFIED,
      breadcrumb: { '@id': `${PAGE_URL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${PAGE_URL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: C.bcHome, item: `${SITE_URL}/${lang}/` },
        { '@type': 'ListItem', position: 2, name: C.bcFerry, item: `${SITE_URL}${ferryPath(lang)}` },
        { '@type': 'ListItem', position: 3, name: C.bcHere, item: PAGE_URL },
      ],
    },
    {
      '@type': 'SpecialAnnouncement',
      '@id': `${PAGE_URL}#status`,
      name: C.schemaName,
      text: C.overview.map(([k, v]) => `${k} ${v}`).join(' '),
      datePosted: LAST_VERIFIED,
      dateModified: LAST_VERIFIED,
      // Machine-readable status for AI answer engines / extraction.
      additionalProperty: { '@type': 'PropertyValue', name: 'crossingStatus', value: MACHINE_STATUS },
      url: PAGE_URL,
      spatialCoverage: {
        '@type': 'Place',
        name: 'Caminha, Portugal',
        geo: { '@type': 'GeoCoordinates', latitude: f.geo.lat, longitude: f.geo.lng },
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${PAGE_URL}#faq`,
      mainEntityOfPage: { '@id': `${PAGE_URL}#webpage` },
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<MainLayout title={C.title} description={C.desc} lang={lang} schemaType="none" i18nUrls={i18nUrls}>
  <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />

  <!-- Hero -->
  <div class="bg-gradient-to-br from-slate-800 via-slate-800 to-forest-950 text-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <nav aria-label={C.bcHere} class="mb-5">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
          <li><a href={`/${lang}/`} class="text-slate-300 hover:text-white no-underline hover:underline">{C.bcHome}</a></li>
          <li aria-hidden="true" class="text-slate-600">›</li>
          <li><a href={ferryPath(lang)} class="text-slate-300 hover:text-white no-underline hover:underline">{C.bcFerry}</a></li>
          <li aria-hidden="true" class="text-slate-600">›</li>
          <li aria-current="page" class="text-slate-200 font-medium">{C.bcHere}</li>
        </ol>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 tracking-tight text-white">{C.h1}</h1>
      <div class="inline-flex items-center gap-2 bg-green-600/20 border border-green-500/40 text-green-300 font-semibold text-sm px-4 py-2 rounded-full">
        <span class="h-2.5 w-2.5 rounded-full bg-green-400 inline-block" aria-hidden="true"></span>
        {C.badge}
      </div>
      <p class="text-slate-300 text-base leading-relaxed max-w-2xl mt-5">
        {C.intro} <strong class="text-white">{LAST_VERIFIED}</strong>.
      </p>
    </div>
  </div>

  <!-- Booking CTA (above the fold) -->
  <div class="bg-forest-50 border-b border-forest-100">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row sm:items-center gap-3">
      <p class="text-sm text-slate-700 flex-1 font-medium"><strong class="text-forest-900">{C.ctaLead}</strong> {C.ctaBody}</p>
      <a
        href={bookingSearch('Caminha, Portugal', `wtsg-ferrystatus-cta-${lang}`)}
        rel="sponsored nofollow noopener"
        target="_blank"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-forest-700 px-5 py-3 text-sm font-bold text-white no-underline hover:bg-forest-800 transition-colors shrink-0"
      >
        {C.ctaBtn}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 space-y-12">

    <!-- Status overview -->
    <section>
      <h2 class="text-2xl font-bold text-forest-900 mb-3 tracking-tight">{C.overviewH}</h2>
      <ul class="space-y-2 text-sm text-slate-700 bg-slate-50 border border-slate-200 rounded-2xl p-5">
        {C.overview.map(([k, v]) => (
          <li><strong>{k}</strong> {v}</li>
        ))}
      </ul>
    </section>

    <EmailSignup lang={lang} />

    <!-- Operators table -->
    <section id="operators">
      <h2 class="text-2xl font-bold text-forest-900 mb-4 tracking-tight">{C.opsH}</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
        <table class="w-full text-sm">
          <caption class="sr-only">{C.opsCaption}</caption>
          <thead>
            <tr class="bg-forest-900 text-white">
              {C.th.map((h) => (
                <th scope="col" class="text-left px-5 py-3.5 font-semibold text-xs uppercase tracking-wider">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {operators.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/70'}>
                <td class="px-5 py-3 font-medium text-slate-800">
                  {row.url ? <a href={row.url} rel="noopener" target="_blank" class="text-forest-700 hover:underline no-underline font-semibold">{row.name}</a> : row.name}
                </td>
                <td class="px-5 py-3 text-slate-700">{row.schedule}</td>
                <td class="px-5 py-3 font-mono font-bold text-forest-700">{row.price}</td>
                <td class="px-5 py-3 text-slate-600 text-xs">
                  {row.booking}
                  {row.phone && <a href={`tel:${row.phone}`} class="block text-forest-700 font-semibold no-underline hover:underline mt-0.5">{row.phone}</a>}
                </td>
                <td class="px-5 py-3 text-slate-600 text-xs">{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-500">{C.opsNote}</p>
    </section>

    <!-- Changelog -->
    <section id="updates">
      <h2 class="text-2xl font-bold text-forest-900 mb-4 tracking-tight">{C.logH}</h2>
      <ol class="relative border-l-2 border-forest-200 ml-2 space-y-6">
        {CHANGELOG.map((c) => (
          <li class="ml-6">
            <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full bg-forest-500 border-2 border-white" aria-hidden="true"></span>
            <p class="text-xs font-bold uppercase tracking-wider text-forest-700">{c.date}</p>
            <p class="text-sm text-slate-700 leading-relaxed mt-1">{c.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- How to choose -->
    <section>
      <h2 class="text-2xl font-bold text-forest-900 mb-3 tracking-tight">{C.chooseH}</h2>
      <div class="grid sm:grid-cols-2 gap-4 text-sm text-slate-700">
        <div class="bg-forest-50 border border-forest-200 rounded-2xl p-5">
          <h3 class="font-bold text-forest-900 mb-2">{C.chooseNowH}</h3>
          <p class="leading-relaxed">{C.chooseNow}</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
          <h3 class="font-bold text-slate-800 mb-2">{C.chooseWaitH}</h3>
          <p class="leading-relaxed">{C.chooseWait}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="text-2xl font-bold text-forest-900 mb-5 tracking-tight">{C.faqH}</h2>
      <div class="space-y-3">
        {FAQ.map((item) => (
          <details class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <summary class="px-6 py-4 font-semibold text-forest-900 cursor-pointer">{item.q}</summary>
            <div class="px-6 pb-5 text-sm text-slate-700 leading-relaxed border-t border-slate-100 pt-3">{item.a}</div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related -->
    <section class="bg-forest-50 border border-forest-200 rounded-2xl p-6">
      <h2 class="text-base font-bold text-forest-900 mb-3">{C.relH}</h2>
      <ul class="space-y-2 text-sm">
        {C.rel.map((label, i) => (
          <li><a href={relHrefs[i]} class="text-forest-700 hover:underline no-underline font-medium">{label}</a></li>
        ))}
      </ul>
    </section>

    <p class="text-xs text-slate-500">{C.sources}</p>
  </div>
</MainLayout>
