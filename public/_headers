# NOT THE LIVE CONFIG. The site is deployed on Vercel, which ignores this file
# entirely — the headers that actually ship are in /vercel.json at the repo root.
# This file is kept only so a move back to Netlify or Cloudflare Pages is a
# one-step change. Any edit here MUST be mirrored in vercel.json or it does
# nothing in production. (Verified 2026-08-12: before vercel.json existed, the
# live site sent no CSP, X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy or Permissions-Policy at all.)
# script-src includes anrdoezrs.net (CJ Affiliate am.js, loaded post-consent);
# omitting it would let CSP block the affiliate script. connect-src covers the
# GA4 regional collection endpoints AND www.qksrv.net — am.js POSTs the page's
# links to qksrv.net/pageImpression, so leaving it out silently kills CJ
# impression reporting (it did, until 2026-07-21). Affiliate *clicks* are
# unaffected by CSP: they are plain server-side links, not fetches.
# form-action allows https: for a future
# external email provider (signup currently disabled). Fonts are self-hosted, so
# font-src/style-src no longer need the Google Fonts origins. frame-src allows the
# OpenStreetMap embed used by the per-stage route map (no API key, no JS).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.anrdoezrs.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.qksrv.net; frame-src https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'; upgrade-insecure-requests;

# Self-hosted fonts are content-hashed by filename stability — cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must revalidate so new versions ship on deploy (never cache-pin).
/sw.js
  Cache-Control: no-cache
